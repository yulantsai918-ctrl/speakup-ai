rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User data: only the user themselves can read/write
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Scenario library: anyone can read, only authenticated can write
    match /scenarios/{scenarioId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Quiz sections: anyone can read, only authenticated can write
    match /quiz_sections/{sectionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
